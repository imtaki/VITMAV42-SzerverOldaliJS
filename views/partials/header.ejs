                <a class="nav-link <%= activePage === 'dashboard' ? 'active' : '' %>" href="/">
                    <svg viewBox="0 0 24 24">
                        <path d="M3 10.5 12 3l9 7.5" />
                        <path d="M5 9.5V21h14V9.5" />
                        <path d="M9 21v-6h6v6" />
                    </svg>
                    Dashboard
                </a>
                <a class="nav-link <%= activePage === 'trainers' ? 'active' : '' %>" href="/trainers">
                    <svg viewBox="0 0 24 24">
                        <circle cx="12" cy="8" r="3.5" />
                        <path d="M5 21c.7-4 3-6 7-6s6.3 2 7 6" />
                    </svg>
                    Személyi edzők
                </a>
                <a class="nav-link <%= activePage === 'workouts' ? 'active' : '' %>" href="/workouts">
                    <svg viewBox="0 0 24 24">
                        <path d="M7 4v16M17 4v16M4 8h16M4 16h16" />
                    </svg>
                    Edzések
                </a>
            </nav>
        </aside>