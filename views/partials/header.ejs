<!DOCTYPE html>
<html lang="hu">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || '5% Fit' %> | 5% Fit</title>
    <link rel="stylesheet" href="/assets/css/style.css">
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=fitness_center" />
</head>

<body>
    <div class="app">
        <aside class="sidebar">
            <div class="logo"><span class="material-symbols-outlined">
                    fitness_center
                </span> 5% Fit</div>
